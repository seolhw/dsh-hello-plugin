{
  "name": "@dsh-talk/server",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "description": "dsh-talk Cloudflare Server: Hono Worker + D1 + R2 + Durable Object",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/sync-dev-vars.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:up": "drizzle-kit up",
    "db:drop": "drizzle-kit drop",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:apply-local": "wrangler d1 migrations apply dsh-talk-server --local",
    "db:apply-remote": "wrangler d1 migrations apply dsh-talk-server --remote",
    "db:reset-local": "node ./scripts/reset-local.mjs",
    "test:smoke": "node ./scripts/ws-smoke.mjs",
    "test": "echo TODO"
  },
  "dependencies": {
    "@dsh-talk/types": "workspace:*",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.7.0",
    "nanoid": "^6.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.129.1"
  },
  "license": "MIT"
}
